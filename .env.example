# Sinyalci - Ortam değişkenleri şablonu
# Kullanım: Bu dosyayı kopyalayıp ".env" olarak kaydedin ve değerleri doldurun.
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# Not: Geçmiş mum ve canlı kline verisi public endpoint'tir;
#      API anahtarı olmadan da bot çalışır. Anahtarlar yalnızca
#      ileride emir gönderme veya özel hesap verisi gerektiğinde kullanılır.

# --- Binance API ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet kullanımı (true / false)
BINANCE_TESTNET=false

# --- Varsayılan bot ayarları (opsiyonel) ---
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1h
DEFAULT_HISTORY_LIMIT=500
